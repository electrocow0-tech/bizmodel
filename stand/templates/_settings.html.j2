{% import "_macros.html.j2" as ui %}
{% set scoring = settings.scoring %}
{% set pipeline = settings.pipeline %}
{% set source = pipeline.get("source") or {} %}
{% set funnel = pipeline.get("funnel") or {} %}
{% set gate = pipeline.get("gate") or {} %}
{% set critic = pipeline.get("critic") or {} %}
{% set team = pipeline.get("assumptions") or {} %}
{% set rubrics = scoring.get("rubrics") or [] %}
{% set trust = scoring.get("trust") or {} %}

{% macro model(route) -%}
<span class="model">{{ route.model }}<small>{{ route.provider|label("provider") }}</small></span>
{%- endmacro %}

{% macro share(value) -%}
{% if value >= 1 %}считается полностью{% elif value == 0 %}не считается{% elif value == 0.5 %}считается наполовину{% else %}доля {{ value }}{% endif %}
{%- endmacro %}

{% macro role_rows(roles) %}
<div class="roles" role="table" aria-label="Модели по ролям">
  <div class="roles__head" role="row"><span role="columnheader">Роль</span><span role="columnheader">Основная модель</span><span role="columnheader">Запасная</span></div>
  {% for row in roles %}
  <div class="roles__row{% if not row.role %} roles__row--more{% endif %}" role="row">
    <span role="cell" class="roles__role">{% if row.role %}{{ row.role|label("role") }}{% if row.effort %}<small>{{ row.effort|label("effort") }}</small>{% endif %}{% endif %}</span>
    <span role="cell" data-cap="Основная модель">{{ model(row.main) }}</span>
    <span role="cell" data-cap="Запасная" class="roles__models">{% for route in row.fallbacks %}{{ model(route) }}{% else %}<span class="quiet">нет</span>{% endfor %}</span>
  </div>
  {% endfor %}
</div>
{% endmacro %}

<section class="panel" id="panel-settings" data-panel="settings" aria-labelledby="h-settings">
  <header class="hero">
    <h1 id="h-settings">С какими настройками шёл прогон</h1>
    <p>Это параметры, с которыми шёл прогон. Сейчас они задаются в файлах настроек; менять их прямо здесь — первый пункт в «Что улучшить».</p>
  </header>

  <div class="sheet">
    <section class="zone" data-section="criteria">
      <p class="zone__cap">Критерии отбора: модель проходит, только если прошла все {{ settings.trees|length }}</p>
      <div class="tree-maps">
        {% for tree in settings.trees %}
        <article class="box">
          <h3 class="box__title">{{ tree.title }}</h3>
          <ol class="qmap">
            {% for question in tree.questions %}
            <li class="qmap__item">
              <span class="qmap__number">{{ question.number }}</span>
              <div class="qmap__body">
                <p class="qmap__label">{{ question.label }}</p>
                <ul class="branches">
                  {% for branch in question.branches %}
                  <li class="branch">
                    <span class="branch__answer">{{ branch.answer|label("branch") }}</span>
                    {% if branch.get("next") %}
                    <span class="branch__to"><b>вопрос {{ branch.next }}</b> {{ branch.text }}</span>
                    {% else %}
                    <span class="branch__to">{{ ui.tag(branch.outcome|label("outcome"), branch.outcome|tone("outcome")) }} {{ branch.text }}</span>
                    {% endif %}
                  </li>
                  {% endfor %}
                </ul>
              </div>
            </li>
            {% endfor %}
          </ol>
        </article>
        {% endfor %}
      </div>
      <p class="sheet__note">Модели отвечают на вопросы «да», «нет» или «не знают», путь и исход считает код. Если модели не знают ответа и отдельной ветки для этого нет, исход: {{ "unknown"|label("outcome") }}.</p>
    </section>

    <div class="duo">
      {% call ui.zone("Шкалы и веса", "weights") %}
      {% set heaviest = rubrics|map(attribute="weight")|max if rubrics else 1 %}
      <ul class="weights">
        {% for rubric in rubrics %}
        <li class="weight foldable">
          <button class="weight__row" type="button" data-fold aria-expanded="false">
            <span class="weight__name">{{ rubric.title }}</span>
            <span class="weight__bar"><i style="--w:{{ (rubric.weight / heaviest)|round(3) }}"></i></span>
            <span class="weight__value">{{ rubric.weight }}</span>
            <span class="chev" aria-hidden="true"></span>
          </button>
          <div class="fold"><div class="fold__in"><div class="weight__more">
            <dl class="levels">
              {% for level, text in rubric.levels.items() %}<dt>{{ level }}</dt><dd>{{ text }}</dd>{% endfor %}
            </dl>
            {% if rubric.get("computed") %}<p class="quiet">Уровень этой шкалы ставит код по итогам проверки возражений, а не модель.</p>{% endif %}
          </div></div></div>
        </li>
        {% endfor %}
      </ul>
      <p class="sheet__text">Каждая шкала даёт от нуля до своего веса: уровень 1 даёт ноль, уровень 3 половину веса, уровень 5 весь вес. Балл складывается из {{ rubrics|length }} шкал, веса в сумме дают {{ rubrics|sum(attribute="weight") }}.</p>
      {% endcall %}

      {% call ui.zone("Возражения, уверенность и доверие", "rules") %}
      <p class="sheet__sub">Сколько весит возражение в оценке устоявших возражений</p>
      <dl class="rules">
        {% for verdict, value in (scoring.get("objection_weight") or {}).items() %}
        <dt>{{ ui.tag(verdict|label("verdict"), verdict|tone("verdict")) }}</dt><dd>{{ share(value) }}</dd>
        {% endfor %}
      </dl>
      <p class="sheet__sub">Уверенность в утверждении</p>
      <dl class="rules">
        {% for level, rule in (scoring.get("confidence") or {}).items() %}
        <dt>{{ ui.tag(level|label("confidence"), level|tone("confidence")) }}</dt><dd>{{ rule }}</dd>
        {% endfor %}
      </dl>
      {% if trust %}
      <p class="sheet__sub">Доверие к карточке</p>
      <p class="sheet__text">Высокое, если цитатой из источника подтверждено не меньше {{ (trust.high * 100)|round|int }}% фактов, среднее от {{ (trust.medium * 100)|round|int }}%, ниже низкое.</p>
      {% endif %}
      {% endcall %}
    </div>

    {% call ui.zone("Воронка", "funnel") %}
    <dl class="facts-list">
      <div><dt>Источник</dt><dd>открытый каталог стартапов, {{ (source.get("url") or "")|host }}</dd></div>
      <div><dt>Компаний в выборке</dt><dd>{{ source.get("sample_size") }}</dd></div>
      <div><dt>Зерно выборки</dt><dd>{{ source.get("seed") }}: с тем же зерном выборка повторяется</dd></div>
      <div><dt>Описание компании</dt><dd>не короче {{ source.get("min_description_chars") }} знаков</dd></div>
      <div><dt>Исключённые регионы</dt><dd>{% for region in source.get("excluded_regions") or [] %}{{ region|label("region") }}{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
      <div><dt>В глубокую проверку</dt><dd>{{ funnel.get("deep_check") }} лучших по грубой оценке</dd></div>
      <div><dt>Из одной отрасли</dt><dd>не больше {{ funnel.get("per_industry_cap") }}</dd></div>
      <div><dt>Контрольная выборка</dt><dd>{{ funnel.get("control_sample") }} отказов дешёвого слоя проходят полную проверку</dd></div>
      <div><dt>Ответ на вопрос принят</dt><dd>если согласны {{ run.quorum }} из {{ run.voters|length }} моделей, иначе решает арбитр</dd></div>
      <div><dt>Поисковых запросов на компанию</dt><dd>{{ gate.get("search_queries") }} при проверке критериев, {{ critic.get("search_queries") }} у критика</dd></div>
      <div><dt>Возражений на проверку</dt><dd>{{ critic.get("objections_to_verify") }} самых сильных</dd></div>
    </dl>
    {% endcall %}

    {% call ui.zone("Модели по ролям, набор «" ~ settings.profile|label("profile") ~ "»", "models") %}
    {{ role_rows(settings.roles) }}
    <p class="sheet__text">Потолок расхода за прогон: {% for provider, budget in settings.budgets.items() %}{{ provider|label("provider") }} {% if budget is none %}без ограничения{% else %}до ${{ budget }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}. Если основная модель не ответила, запрос уходит запасной.</p>
    <div class="more foldable">
      <button class="more__head" type="button" data-fold aria-expanded="false">Цены за миллион токенов<span class="chev" aria-hidden="true"></span></button>
      <div class="fold"><div class="fold__in">
        <div class="prices" role="table" aria-label="Цены за миллион токенов">
          <div class="prices__head" role="row"><span role="columnheader">Модель</span><span role="columnheader">Вход, $</span><span role="columnheader">Выход, $</span></div>
          {% for name, price in settings.prices.items() %}
          <div class="prices__row" role="row"><span role="cell">{{ name }}</span><span role="cell">{{ price[0] }}</span><span role="cell">{{ price[1] }}</span></div>
          {% endfor %}
        </div>
      </div></div>
    </div>
    {% if settings.other_profiles %}
    <div class="more foldable">
      <button class="more__head" type="button" data-fold aria-expanded="false">Другие наборы моделей: {% for name in settings.other_profiles %}{{ name|label("profile") }}{% if not loop.last %}, {% endif %}{% endfor %}<span class="chev" aria-hidden="true"></span></button>
      <div class="fold"><div class="fold__in">
        {% for name, roles in settings.other_profiles.items() %}
        <p class="sheet__sub">Набор «{{ name|label("profile") }}»</p>
        {{ role_rows(roles) }}
        {% endfor %}
      </div></div>
    </div>
    {% endif %}
    {% endcall %}

    <div class="duo">
      {% call ui.zone("Допущения о команде", "team") %}
      <dl class="facts-list facts-list--single">
        <div><dt>Команда</dt><dd>{{ team.get("team") }}</dd></div>
        <div><dt>Бюджет теста</dt><dd>${{ (team.get("test_budget_usd") or 0)|thousands }}</dd></div>
        <div><dt>Горизонт</dt><dd>{{ team.get("horizon_weeks") }} {{ (team.get("horizon_weeks") or 0)|plural("неделя", "недели", "недель") }}</dd></div>
        <div><dt>Рынок</dt><dd>{{ team.get("market") }}</dd></div>
      </dl>
      <p class="sheet__text quiet">На эти допущения опираются оценки и советник.</p>
      {% endcall %}

      {% call ui.zone("Компании холдинга", "holding") %}
      {% if settings.holding %}
      <dl class="facts-list facts-list--single">
        {% for company in settings.holding %}<div><dt>{{ company.get("name") }}</dt><dd>{{ company.get("customers") }}</dd></div>{% endfor %}
      </dl>
      {% else %}
      <p class="sheet__text">Список пуст. Если вписать компании холдинга и их клиентов, советник в каждой карточке назовёт, к какой из них находку можно пристегнуть как допродажу.</p>
      {% endif %}
      {% endcall %}
    </div>

    {% call ui.zone("Ответы человека", "answers") %}
    <p class="sheet__text">Правок человека в этом прогоне: {{ settings.overrides }}. Ответ человека побеждает голоса моделей; сейчас он вписывается в файл, на стенде — в «Что улучшить».</p>
    {% if settings.open_questions %}
    <p class="sheet__sub">Открытые вопросы этого прогона: {{ settings.open_questions|length }}</p>
    <ul class="open-questions">
      {% for item in settings.open_questions %}
      <li><a href="#forest/{{ item.slug }}">{{ item.company }}</a><span>{{ item.question }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% endcall %}

    {% call ui.zone("Инструкции моделей", "prompts") %}
    <ul class="prompts">
      {% for role, text in settings.prompts.items() %}
      <li class="foldable">
        <button class="more__head" type="button" data-fold aria-expanded="false">{{ role|label("role") }}<span class="chev" aria-hidden="true"></span></button>
        <div class="fold"><div class="fold__in"><pre class="prompt">{{ text }}</pre></div></div>
      </li>
      {% endfor %}
    </ul>
    {% endcall %}
  </div>
</section>
