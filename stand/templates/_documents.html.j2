<section class="panel" id="panel-documents" data-panel="documents" aria-labelledby="h-documents">
  <header class="hero">
    <h1 id="h-documents">Решения и то, что работает криво</h1>
    <p>Почему конвейер устроен так, что было отброшено, как распределены веса. И отдельно честный список слабых мест.</p>
  </header>
  <div class="papers">
    <article class="prose">
      {% if documents.get("decisions") %}
      {{ documents["decisions"]|md }}
      {% else %}
      <h2>Решения</h2>
      <p class="quiet">Файл решений появится здесь после финального прогона.</p>
      {% endif %}
    </article>
    <article class="prose">
      {% if documents.get("limitations") %}
      {{ documents["limitations"]|md }}
      {% else %}
      <h2>Что не работает или работает криво</h2>
      <p class="quiet">Список появится здесь после финального прогона.</p>
      {% endif %}
    </article>
  </div>
</section>
