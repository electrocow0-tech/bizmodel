{% import "_macros.html.j2" as ui %}
{% set funnel = run.funnel %}
{% set whole = funnel.sourced or 1 %}
{% set through = funnel.queued + funnel.deep_checked %}
{% set sampled = run.control.slugs|length %}
{% set wrong = run.control.wrongly_rejected|length %}
<section class="panel" id="panel-forest" data-panel="forest" aria-labelledby="h-forest">
  <header class="hero">
    <h1 id="h-forest">Из {{ funnel.sourced }} моделей все пять критериев {{ funnel.gate_passed|plural("прошла", "прошли", "прошли") }} {{ funnel.gate_passed }}</h1>
    <p>Дешёвый слой читает описание и отсекает явные нарушения. Лучшие идут в глубокую проверку: пять деревьев вопросов, на каждый вопрос отвечают пять независимых моделей, исход считает код.</p>
  </header>

  <ol class="funnel">
    <li style="--w:1"><b>{{ funnel.sourced }}</b><span>взято из каталога</span><i></i><small>случайная выборка по отраслям</small></li>
    <li style="--w:{{ (through / whole)|round(3) }}"><b>{{ through }}</b><span>прошли дешёвый слой</span><i></i><small>{{ funnel.prescreen_rejected }} отсеяно по описанию{% if cheap_layer.failed %}, {{ cheap_layer.failed|length }} со сбоем{% endif %}</small></li>
    <li style="--w:{{ (funnel.deep_checked / whole)|round(3) }}"><b>{{ funnel.deep_checked }}</b><span>глубокая проверка</span><i></i><small>{{ funnel.queued }} ждут в очереди</small></li>
    <li style="--w:{{ (funnel.gate_passed / whole)|round(3) }}"><b>{{ funnel.gate_passed }}</b><span>прошли пять критериев</span><i></i><small>{{ funnel.gate_failed }} отказ, {{ funnel.gate_unknown }} не удалось проверить</small></li>
    <li style="--w:{{ (funnel.carded / whole)|round(3) }}"><b>{{ funnel.carded }}</b><span>получили карточку</span><i></i><small>{{ funnel.unverified }} не проверено из-за сбоя шага</small></li>
  </ol>

  <section class="block">
    <h2>Контроль ложных отказов</h2>
    <p class="lead">
      {% if sampled %}
      Из отсеянных дешёвым слоем случайно {{ sampled|plural("взята", "взяты", "взято") }} {{ sampled }} и {{ sampled|plural("проверена", "проверены", "проверено") }} лесом.
      {% if wrong %}
      Лес не согласился с {{ wrong }} {{ wrong|plural("отказом", "отказами", "отказами") }}:
      {% for slug in run.control.wrongly_rejected %}{{ run.companies[slug].name }}{% if not loop.last %}, {% endif %}{% endfor %}.
      {% else %}
      Все отказы подтвердились.
      {% endif %}
      {% else %}
      В этом прогоне контрольная выборка не бралась.
      {% endif %}
    </p>
  </section>

  <section class="block">
    <h2>Путь каждой модели по критериям</h2>
    <p class="lead">Пять точек в строке: пять критериев по порядку. Раскройте модель, чтобы увидеть вопросы и голоса.</p>
    <p class="legend">
      <span><i class="dot dot--pass"></i>прошла</span>
      <span><i class="dot dot--fail"></i>отказ</span>
      <span><i class="dot dot--unknown"></i>не удалось проверить</span>
      <span><i class="vote vote--yes"></i>голос «да»</span>
      <span><i class="vote vote--no"></i>голос «нет»</span>
      <span><i class="vote vote--unknown"></i>голос «неизвестно»</span>
    </p>
    <ul class="rows">
      {% for item in forest %}
      {% set gate = item.gate %}
      {% set stoppers = gate.trees|rejectattr("outcome", "equalto", "pass")|list %}
      <li class="row foldable" id="gate-{{ gate.slug }}" data-slug="{{ gate.slug }}">
        <button class="row__head" type="button" data-fold aria-expanded="false" aria-controls="gate-body-{{ gate.slug }}">
          <span class="row__grid row__grid--dots">
            <span class="row__title">
              <span class="row__name">{{ item.company.name }}{% if item.is_control %} {{ ui.tag("контроль") }}{% endif %}</span>
              <span class="row__line">{% if stoppers %}{{ stoppers[0].title }}: {{ stoppers[0].reason }}{% else %}{{ item.company.one_liner }}{% endif %}</span>
            </span>
            <span class="row__dots" role="img" aria-label="Критерии: {% for tree in gate.trees %}{{ tree.outcome|label('outcome') }}{% if not loop.last %}, {% endif %}{% endfor %}">
              {%- for tree in gate.trees %}<i class="dot dot--{{ tree.outcome }}" title="{{ tree.title }}: {{ tree.outcome|label('outcome') }}"></i>{% endfor -%}
            </span>
            <span class="row__state">{{ ui.tag(gate.outcome|label("outcome"), gate.outcome|tone("outcome")) }}</span>
            <span class="chev" aria-hidden="true"></span>
          </span>
        </button>
        <div class="fold">
          <div class="fold__in" id="gate-body-{{ gate.slug }}">
            <div class="row__body">
              <p class="quiet">Порядок голосов: {{ item.voters|join(", ") }}. Версия леса {{ gate.forest_version }}.</p>
              <div class="trees">
                {% for view in item.trees %}
                <section class="tree">
                  <h3>{{ view.tree.title }}</h3>
                  <ol class="path">
                    {% for step in view.steps %}
                    <li class="path__step is-{{ step.state }}">
                      <span class="path__node">{{ loop.index }}</span>
                      <div class="path__body">
                        <p class="path__question">{{ step.decision.question }}</p>
                        <p class="path__ruling">{{ ui.ruling(step.decision) }}</p>
                        {{ ui.proof(step.passport) }}
                      </div>
                    </li>
                    {% endfor %}
                  </ol>
                  <p class="tree__reason">{{ ui.tag(view.tree.outcome|label("outcome"), view.tree.outcome|tone("outcome")) }} {{ view.tree.reason }}</p>
                </section>
                {% endfor %}
              </div>
              {% if item.off_path %}
              <section class="aside">
                <h3>Вопросы вне пройденного пути</h3>
                <ul class="offpath">
                  {% for step in item.off_path %}
                  <li><span>{{ step.decision.question }}</span><span class="path__ruling">{{ ui.ruling(step.decision) }}</span></li>
                  {% endfor %}
                </ul>
              </section>
              {% endif %}
              <section class="aside">
                <h3>Открытые источники</h3>
                <ul class="sources">
                  {% for evidence in gate.evidence %}
                  <li><span>{{ evidence.id }}</span><a href="{{ evidence.url|web }}" rel="noopener" target="_blank">{{ evidence.title }}</a><span>{{ evidence.url|host }}, {% if evidence.published %}источник от {{ evidence.published|day }}{% else %}дата источника не указана{% endif %}, открыт {{ evidence.accessed|day }}</span><code>{{ evidence.sha256[:12] }}</code></li>
                  {% endfor %}
                </ul>
              </section>
              <p class="links">
                {% if item.has_card %}<a href="#rating/{{ gate.slug }}">Открыть карточку</a>{% endif %}
                {% if item.wrongly_rejected %}<span class="quiet">Дешёвый слой отсеял эту модель, лес с отказом не согласился.</span>{% endif %}
              </p>
            </div>
          </div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="block">
    <h2>Отказы дешёвого слоя</h2>
    <p class="lead">Решение принято по одному описанию, источники не проверялись. Причина и сработавший критерий записаны для каждой модели.</p>
    <ul class="rows">
      {% for group in cheap_layer.rejected %}
      <li class="row foldable">
        <button class="row__head" type="button" data-fold aria-expanded="false">
          <span class="row__grid row__grid--count">
            <b class="row__count">{{ group.companies|length }}</b>
            <span class="row__name">{{ group.title }}</span>
            <span class="chev" aria-hidden="true"></span>
          </span>
        </button>
        <div class="fold"><div class="fold__in">
          <ul class="reasons">
            {% for entry in group.companies %}<li><b>{{ entry.company.name }}</b><span>{{ entry.reason }}</span></li>{% endfor %}
          </ul>
        </div></div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="block">
    <h2>Очередь на глубокую проверку</h2>
    <p class="lead">Эти модели прошли дешёвый слой, но не попали в {{ funnel.deep_checked }} лучших. Грубая оценка скорости до первой оплаты: от 1 до {{ ui.top_level }}.</p>
    <ul class="rows">
      <li class="row foldable">
        <button class="row__head" type="button" data-fold aria-expanded="false">
          <span class="row__grid row__grid--count">
            <b class="row__count">{{ cheap_layer.queued|length }}</b>
            <span class="row__name">в очереди</span>
            <span class="chev" aria-hidden="true"></span>
          </span>
        </button>
        <div class="fold"><div class="fold__in">
          <ul class="reasons">
            {% for entry in cheap_layer.queued %}<li><b>{{ entry.company.name }}</b><span>{{ entry.prescreen.speed }} из {{ ui.top_level }}. {{ entry.prescreen.speed_reason }}</span></li>{% endfor %}
          </ul>
        </div></div>
      </li>
    </ul>
  </section>
</section>
