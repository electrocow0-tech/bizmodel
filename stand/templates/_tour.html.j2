{% autoescape false %}
{% set f = run.funnel %}
{% set voters = run.voters|length %}
{% set steps = [] %}

{% set text %}Точки — компании. Из каталога взято {{ f.sourced }}, до карточки {{ f.carded|plural("дошла", "дошли", "дошли") }} {{ f.carded }}: на каждом этапе часть отсеивается.{% endset %}
{% set _ = steps.append({"title": "Как устроен конвейер", "text": text, "tab": "how", "hash": "how", "open": [], "stage": "", "target": "flow"}) %}

{% set text %}На каждый вопрос отвечают {{ voters }} {{ voters|plural("модель", "модели", "моделей") }}, ответ принят, если согласны {{ run.quorum }} из {{ voters }}. Иначе решает арбитр, если и он не уверен, вопрос уходит человеку.{% endset %}
{% set _ = steps.append({"title": "Проверка по критериям", "text": text, "tab": "how", "hash": "how", "open": [], "stage": "gate", "target": "stage-panel-gate"}) %}

{% if how.top %}
{% set card = how.top %}
{% set text %}Самая перспективная модель: {{ card.name }}, {{ card.score|round|int }} из 100. Сверху схема денег, ниже коротко: совет, главный риск и тест.{% endset %}
{% set _ = steps.append({"title": "Лучшая карточка", "text": text, "tab": "rating", "hash": "rating/" ~ card.slug, "open": ["card-" ~ card.slug], "stage": "", "target": "card-head-" ~ card.slug}) %}

{% if card.advice %}
{% set text %}Советник читает готовую карточку и пишет, что делать: здесь «{{ card.advice.verdict|label("advice") }}». На балл и место в рейтинге он не влияет.{% endset %}
{% set _ = steps.append({"title": "Совет собственнику", "text": text, "tab": "rating", "hash": "rating/" ~ card.slug, "open": ["card-" ~ card.slug], "stage": "", "target": "advice-" ~ card.slug}) %}
{% endif %}
{% endif %}

{% set text %}Здесь задаются выборка, веса шкал, допущения о команде и набор моделей. Запуск по коду: прогон идёт на сервере и сам обновит стенд.{% endset %}
{% set _ = steps.append({"title": "Настройки и запуск", "text": text, "tab": "run", "hash": "run", "open": [], "stage": "", "target": "launch-form"}) %}

{% set text %}Честный список того, что пока не готово, и что изменится в полной версии.{% endset %}
{% set _ = steps.append({"title": "Что улучшить", "text": text, "tab": "improve", "hash": "improve", "open": [], "stage": "", "target": "h-improve", "final": true}) %}
<script type="application/json" id="tour-steps">{{ steps|tojson }}</script>
{% endautoescape %}
