{% set top_level = 5 %}

{% macro tag(text, tone="plain") -%}
<span class="tag tag--{{ tone }}">{{ text }}</span>
{%- endmacro %}

{% macro meter(level) -%}
<span class="meter" role="img" aria-label="{{ level }} из {{ top_level }}">
  {%- for step in range(1, top_level + 1) %}<i{% if step <= level %} class="on"{% endif %}></i>{% endfor -%}
</span>
{%- endmacro %}

{% macro advice_tag(card) -%}
{% set key = card.advice.verdict if card.advice else "missing" %}
{{ tag(key|label("advice"), key|tone("advice")) }}
{%- endmacro %}

{% macro verdict_tag(objection) -%}
{% set key = objection|verdict_key %}
{{ tag(key|label("verdict"), key|tone("verdict")) }}
{%- endmacro %}

{% macro trust_bar(card) -%}
{% set methods = ["primary_source", "calculation", "model_judgment", "needs_human"] %}
{% set total = card.trust.by_method.values()|sum or 1 %}
<span class="shares" role="img" aria-label="{% for method in methods if card.trust.by_method.get(method) %}{{ method|label('method') }} {{ card.trust.by_method[method] }}{% if not loop.last %}, {% endif %}{% endfor %}">
  {%- for method in methods if card.trust.by_method.get(method) %}<i class="share share--{{ method|tone('method') }}" style="--w:{{ (card.trust.by_method[method] / total)|round(3) }}"></i>{% endfor -%}
</span>
{%- endmacro %}

{% macro trust_legend(card) -%}
<span class="shares__legend">
  {%- for method in ["primary_source", "calculation", "model_judgment", "needs_human"] if card.trust.by_method.get(method) %}<span><i class="share share--{{ method|tone('method') }}"></i>{{ method|label("method") }} {{ card.trust.by_method[method] }}</span>{% endfor -%}
</span>
{%- endmacro %}

{% macro trust_line(card) -%}
{% set total = card.trust.by_method.values()|sum %}
{% set primary = card.trust.by_method.get("primary_source", 0) %}
{% set human = card.trust.by_method.get("needs_human", 0) %}
{{ (card.trust.level|label("trust"))|capitalize }}: {{ primary }} из {{ total }} {{ total|plural("утверждения", "утверждений", "утверждений") }} {{ primary|plural("опирается", "опираются", "опираются") }} на первоисточник{% if human %}, {{ human }} {{ human|plural("ждёт", "ждут", "ждут") }} человека{% endif %}.
{%- endmacro %}

{% macro main_risk(card) -%}
{% set confirmed = card.objections|selectattr("verdict", "equalto", "supported")|list %}
{% if card.advice %}{{ card.advice.main_risk }}{% elif confirmed %}{{ (confirmed|sort(attribute="strength", reverse=true)|first).text }}{% else %}Не назван.{% endif %}
{%- endmacro %}

{% macro trust_tag(card) -%}
{{ tag("доверие " ~ card.trust.level|label("trust"), card.trust.level|tone("trust")) }}
{%- endmacro %}

{% macro fingerprint(card) -%}
<span class="print" role="img" aria-label="Шесть оценок: {% for rubric in card.rubrics %}{{ rubric.level }}{% if not loop.last %}, {% endif %}{% endfor %}">
  {%- for rubric in card.rubrics %}<i style="--h:{{ rubric.level / top_level }}" title="{{ rubric.title }}: {{ rubric.level }} из {{ top_level }}"></i>{% endfor -%}
</span>
{%- endmacro %}

{% macro votes(decision) -%}
<span class="votes" role="img" aria-label="Голоса: {% for vote in decision.votes %}{{ vote.answer|label('answer') }}{% if not loop.last %}, {% endif %}{% endfor %}">
  {%- for vote in decision.votes %}<i class="vote vote--{{ vote.answer }}" title="{{ vote.voter }}: {{ vote.answer|label('answer') }}{% if vote.quote %}. «{{ vote.quote }}»{% endif %}"></i>{% endfor -%}
</span>
{%- endmacro %}

{% macro ruling(decision) -%}
{% set agreed = (decision.agreement * decision.votes|length)|round|int %}
<b>{{ decision.answer|label("answer") }}</b>
<span>{{ decision.decided_by|label("decided_by") }}{% if decision.votes %}, согласны {{ agreed }} из {{ decision.votes|length }}{% endif %}</span>
{% if decision.votes %}{{ votes(decision) }}{% endif %}
{%- endmacro %}

{% macro source(url) -%}
<a href="{{ url|web }}" rel="noopener" target="_blank">{{ url|host }}</a>
{%- endmacro %}

{% macro proof(passport) %}
{% if passport %}
<p class="path__proof">
  {{ tag(passport.method|label("method"), passport.method|tone("method")) }}
  {{ tag("уверенность " ~ passport.confidence|label("confidence"), passport.confidence|tone("confidence")) }}
  {% if passport.source_url %}{{ source(passport.source_url) }}{% endif %}
  {% if passport.quote %}<q>{{ passport.quote }}</q>{% endif %}
</p>
{% endif %}
{% endmacro %}

{% macro objection_item(objection, owner) %}
<li class="objection foldable" id="obj-{{ owner }}-{{ objection.id }}">
  <div class="objection__row">
    <p class="objection__text">{{ objection.text }}</p>
    <p class="objection__meta">{{ verdict_tag(objection) }}<span>сила {{ objection.strength }} из {{ top_level }}</span></p>
  </div>
  <button class="more__head" type="button" data-fold aria-expanded="false">подробнее<span class="chev" aria-hidden="true"></span></button>
  <div class="fold"><div class="fold__in"><div class="objection__more">
    <p><span class="key">Критик.</span> {{ objection.reasoning }}</p>
    {% if objection.quote %}
    <blockquote>«{{ objection.quote }}»{% if objection.source_url %} <cite>{{ source(objection.source_url) }}{% if objection.source_date %}, {{ objection.source_date|day }}{% endif %}</cite>{% endif %}</blockquote>
    {% endif %}
    {% if objection.verifier_note or objection.verifier_quote %}
    <p><span class="key">Проверяющий.</span> {{ objection.verifier_note }}{% if objection.verifier_quote %} «{{ objection.verifier_quote }}»{% endif %}</p>
    {% endif %}
  </div></div></div>
</li>
{% endmacro %}

{% macro zone(caption, section, anchor="") %}
<section class="zone"{% if anchor %} id="{{ anchor }}"{% endif %} data-section="{{ section }}">
  <p class="zone__cap">{{ caption }}</p>
  <div class="box">{{ caller() }}</div>
</section>
{% endmacro %}

{% macro card_item(card, cards_total) %}
<li class="card foldable" id="card-{{ card.slug }}" data-slug="{{ card.slug }}" data-score="{{ card.score }}" style="--lum:{{ (card.score / 100)|round(2) }}">
  <button class="card__head" id="card-head-{{ card.slug }}" type="button" data-fold aria-expanded="false" aria-controls="card-body-{{ card.slug }}">
    <span class="card__grid">
      <span class="card__rank"><b>{{ card.rank }}</b><small>место из {{ cards_total }}</small></span>
      <span class="card__title">
        <span class="card__name">{{ card.name }}</span>
        <span class="card__line">{{ card.one_liner }}</span>
      </span>
      {{ fingerprint(card) }}
      <span class="card__score"><b>{{ card.score|round|int }}</b><small>из 100</small></span>
      <span class="card__state">{{ advice_tag(card) }}{{ trust_tag(card) }}</span>
      <span class="chev" aria-hidden="true"></span>
    </span>
    <span class="schema">
      <span><small>Кто платит</small>{{ card.business_model.payer }}</span>
      <span><small>За что</small>{{ card.business_model.pays_for }}</span>
      <span><small>Как часто</small>{{ card.business_model.frequency }}</span>
    </span>
  </button>
  <div class="fold">
    <div class="fold__in" id="card-body-{{ card.slug }}">
      <div class="card__body">
        <section class="zone" id="brief-{{ card.slug }}">
          <p class="zone__cap">Коротко</p>
          <div class="tiles">
            <article class="box tile" id="advice-{{ card.slug }}" data-section="advice">
              <p class="tile__label">Совет {{ tag("суждение модели") }}</p>
              {% if card.advice %}
              <p class="tile__verdict">{{ card.advice.verdict|label("advice") }}</p>
              <p class="key">Первый шаг</p>
              <p>{{ card.advice.first_step }}</p>
              {% if card.advice.flagged_numbers %}
              <p class="quiet">В совете есть числа вне карточки: {{ card.advice.flagged_numbers|join(", ") }}.</p>
              {% endif %}
              <div class="more foldable">
                <button class="more__head" type="button" data-fold aria-expanded="false">Бюджет и когда остановить<span class="chev" aria-hidden="true"></span></button>
                <div class="fold"><div class="fold__in"><dl class="pairs">
                  <dt>Сколько вложить в тест</dt><dd>{{ card.advice.test_budget }}</dd>
                  <dt>Когда остановить тест</dt><dd>{{ card.advice.stop_signal }}</dd>
                </dl></div></div>
              </div>
              {% else %}
              <p class="quiet">Шаг советника для этой карточки не выполнен.</p>
              {% endif %}
            </article>
            <article class="box tile" data-section="risk">
              <p class="tile__label">Главный риск</p>
              <p class="tile__lead">{{ main_risk(card) }}</p>
            </article>
            <article class="box tile" data-section="test">
              <p class="tile__label">Тест</p>
              <dl class="pairs">
                <dt>Канал</dt><dd>{{ card.test_sketch.channel }}</dd>
                <dt>Предложение</dt><dd>{{ card.test_sketch.offer }}</dd>
                <dt>Признак успеха</dt><dd>{{ card.test_sketch.success_sign }}</dd>
              </dl>
            </article>
          </div>
        </section>

        {% call zone("Оценки", "scores", "scores-" ~ card.slug) %}
        <ul class="rubrics">
          {% for rubric in card.rubrics %}
          <li class="rubric foldable">
            <button class="rubric__row" type="button" data-fold aria-expanded="false">
              <span class="rubric__name">{{ rubric.title }}</span>
              <span class="rubric__weight">вес {{ rubric.weight }}</span>
              {{ meter(rubric.level) }}
              <span class="rubric__level">{{ rubric.level }} из {{ top_level }}</span>
              <span class="chev" aria-hidden="true"></span>
            </button>
            <div class="fold"><div class="fold__in"><p class="rubric__why">{{ rubric.why }}</p></div></div>
          </li>
          {% endfor %}
        </ul>
        {% endcall %}

        {% call zone("Почему может не сработать", "objections") %}
        {% set checked = card.objections|selectattr("sent_to_verifier")|list %}
        {% set unchecked = card.objections|rejectattr("sent_to_verifier")|list %}
        <ul class="objections">
          {% for objection in checked %}{{ objection_item(objection, card.slug) }}{% endfor %}
        </ul>
        {% if unchecked %}
        <div class="more foldable">
          <button class="more__head" type="button" data-fold aria-expanded="false">Ещё {{ unchecked|length }} {{ unchecked|length|plural("возражение", "возражения", "возражений") }} без проверки источника<span class="chev" aria-hidden="true"></span></button>
          <div class="fold"><div class="fold__in"><ul class="objections">
            {% for objection in unchecked %}{{ objection_item(objection, card.slug) }}{% endfor %}
          </ul></div></div>
        </div>
        {% endif %}
        {% endcall %}

        <div class="boxes">
          {% call zone("Что нужно от человека", "human") %}
          {% if card.needs_human %}
          <ul class="plain">{% for item in card.needs_human %}<li>{{ item }}</li>{% endfor %}</ul>
          {% else %}
          <p class="quiet">Открытых вопросов нет.</p>
          {% endif %}
          {% endcall %}

          {% call zone("Кому допродаётся", "upsell") %}
          <p>{{ card.upsell }}</p>
          {% endcall %}

          {% call zone("Доверие к карточке, отдельно от балла", "trust") %}
          <p>{{ trust_line(card) }}</p>
          {{ trust_bar(card) }}
          {{ trust_legend(card) }}
          {% endcall %}

          {% call zone("Компания-пример", "anchor") %}
          <p>{{ card.anchor }}</p>
          <p class="links">{{ source(card.website) }} <a href="{{ card.yc_url|web }}" rel="noopener" target="_blank">страница в каталоге</a> <a href="#forest/{{ card.slug }}">путь по критериям</a></p>
          {% endcall %}
        </div>

        {% call zone("Паспорта утверждений", "passports") %}
        <div class="more foldable" id="pp-{{ card.slug }}">
          <button class="more__head" type="button" data-fold aria-expanded="false">{{ card.passports|length }} {{ card.passports|length|plural("утверждение", "утверждения", "утверждений") }}: источник, дата, метод, уверенность<span class="chev" aria-hidden="true"></span></button>
          <div class="fold"><div class="fold__in">
          <div class="passports" id="pp-table-{{ card.slug }}" role="table" aria-label="Паспорта утверждений">
            <div class="passports__head" role="row">
              <span role="columnheader">Утверждение</span><span role="columnheader">Источник</span><span role="columnheader">Дата источника</span><span role="columnheader">Обращение</span><span role="columnheader">Метод</span><span role="columnheader">Уверенность</span>
            </div>
            {% for passport in card.passports %}
            <div class="passport" role="row">
              <span role="cell" class="passport__claim">{{ passport.claim }}<small>{{ passport.origin|label("origin") }}{% if passport.note %}. {{ passport.note }}{% endif %}</small></span>
              <span role="cell" data-cap="Источник">{% if passport.source_url %}{{ source(passport.source_url) }}{% else %}<span class="quiet">нет</span>{% endif %}{% if passport.quote %}<q>{{ passport.quote }}</q>{% endif %}</span>
              <span role="cell" data-cap="Дата источника">{{ passport.source_date|day_or_none }}</span>
              <span role="cell" data-cap="Обращение">{{ passport.accessed|day_or_none }}</span>
              <span role="cell" data-cap="Метод">{{ tag(passport.method|label("method"), passport.method|tone("method")) }}</span>
              <span role="cell" data-cap="Уверенность">{{ tag(passport.confidence|label("confidence"), passport.confidence|tone("confidence")) }}</span>
            </div>
            {% endfor %}
          </div>
          </div></div>
        </div>
        {% endcall %}
      </div>
    </div>
  </div>
</li>
{% endmacro %}
